<?php

function validarCPF($cpf) {
    $cpf = preg_replace('/[^0-9]/', '', $cpf);

    if (strlen($cpf) != 11) return false;
    if (preg_match('/(\d)\1{10}/', $cpf)) return false;

    for ($t = 9; $t < 11; $t++) {
        for ($d = 0, $c = 0; $c < $t; $c++) {
            $d += $cpf[$c] * (($t + 1) - $c);
        }
        $d = ((10 * $d) % 11) % 10;
        if ($cpf[$c] != $d) return false;
    }

    return true;
}

$msg = "";

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $login = $_POST['login'];
    $senha = $_POST['senha'];

    $conn = new mysqli("localhost", "root", "", "cadastro_db");

    if ($conn->connect_error) die("Erro");

    $tipo = "";
    $loginFinal = $login;

    if (filter_var($login, FILTER_VALIDATE_EMAIL)) {
        $tipo = "email";
    } elseif (preg_match('/^\d{10,11}$/', $login)) {
        $tipo = "telefone";
    } elseif (validarCPF($login)) {
        $tipo = "cpf";
        $loginFinal = password_hash($login, PASSWORD_DEFAULT);
    } else {
        $msg = "Login inválido!";
    }

    if ($msg == "") {

        $senhaHash = password_hash($senha, PASSWORD_DEFAULT);

        $stmt = $conn->prepare("INSERT INTO usuarios (login, senha, tipo) VALUES (?, ?, ?)");
        $stmt->bind_param("sss", $loginFinal, $senhaHash, $tipo);

        $msg = $stmt->execute() ? "Cadastro realizado!" : "Erro ao cadastrar.";

        $stmt->close();
        $conn->close();
    }
}
